function renderRows(){
  const container = document.getElementById('form-rows');
  container.innerHTML = '';
  holdings.forEach(h=>{
    const row = document.createElement('div');
    row.className = 'field-group';
    row.innerHTML = `
      <input type="text" placeholder="e.g. AAPL or Apple" value="${h.name}"
        onchange="updateHolding(${h.id},'name',this.value)"
        oninput="autoClassify(${h.id},this.value)">
      <select onchange="updateHolding(${h.id},'assetClass',this.value)" id="class-${h.id}">
