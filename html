// =============================================
function checkReady(){
  let ready = false;
  if(activeTab==='form'){
    const total = holdings.reduce((s,h)=>s+(parseFloat(h.alloc)||0),0);
    ready = holdings.length>=2 && Math.abs(total-100)<1;
  } else {
    const total = pastedHoldings.reduce((s,h)=>s+h.alloc,0);
    ready = pastedHoldings.length>=2 && Math.abs(total-100)<2;
  }
  document.getElementById('analyse-btn').disabled = !ready;
}

// =============================================
// ANALYSIS ENGINE
// =============================================
function runAnalysis(){
  const raw = activeTab==='form'
    ? holdings.map(h=>({name:h.name||h.assetClass, assetClass:h.assetClass, alloc:parseFloat(h.alloc)||0}))
    : pastedHoldings;

  const portfolio = raw.filter(h=>h.alloc>0);

  // Normalise allocations
  const totalAlloc = portfolio.reduce((s,h)=>s+h.alloc,0);
  portfolio.forEach(h=>h.weight = h.alloc/totalAlloc);

  // Compute weighted portfolio correlation
  let weightedAvgCorr = 0;
  let pairCount = 0;
  for(let i=0;i<portfolio.length;i++){
    for(let j=i+1;j<portfolio.length;j++){
      const corr = getCorr(portfolio[i].assetClass, portfolio[j].assetClass);
      weightedAvgCorr += corr * portfolio[i].weight * portfolio[j].weight;
      pairCount++;
    }
  }

  // Diversification score (0-100, higher = better)
  // Based on average pairwise correlation — lower corr = more diversified
  const avgPairCorr = pairCount > 0 ? portfolio.reduce((sum,a,i)=>{
    let rowSum = 0;
    portfolio.forEach((b,j)=>{ if(i!==j) rowSum += getCorr(a.assetClass,b.assetClass); });
    return sum + (rowSum/(portfolio.length-1)) * a.weight;
  }, 0) : 0;

  const score = Math.round(Math.max(0, Math.min(100, (1 - avgPairCorr) * 100)));

  document.getElementById('results').style.display = 'block';
  document.getElementById('results').classList.add('show');

  renderScore(score, portfolio);
  renderHeatmap(portfolio);
  renderConcentrationBars(portfolio);
  renderBuckets(portfolio);
  renderInsights(score, portfolio, avgPairCorr);

  setTimeout(()=>{
    document.getElementById('results').scrollIntoView({behavior:'smooth',block:'start'});
  }, 100);
}

function getCorr(a, b){
  if(!CORR[a]||!CORR[a][b]) return 0.5;
  return CORR[a][b];
}

// =============================================
// RENDER SCORE
// =============================================
function renderScore(score, portfolio){
  const color = score>=70?'var(--green)':score>=45?'var(--yellow)':'var(--red)';
  const label = score>=70?'WELL DIVERSIFIED':score>=45?'PARTIALLY DIVERSIFIED':'CONCENTRATED PORTFOLIO';
  const verdict = score>=70
    ? `Your portfolio shows genuine diversification across multiple uncorrelated asset classes. You have real protection when one market segment sells off.`
    : score>=45
    ? `Your portfolio has some diversification but significant concentration risk remains. Several of your holdings tend to move together, which amplifies losses during downturns.`
    : `Your portfolio is heavily concentrated. Most of your holdings are highly correlated — meaning when one falls, they likely all fall. You may think you're diversified, but you're essentially making one big bet.`;

  // Asset class exposure tags
  const classExposure = {};
  portfolio.forEach(h=>{
    classExposure[h.assetClass] = (classExposure[h.assetClass]||0) + h.weight*100;
  });

  const topExposures = Object.entries(classExposure).sort((a,b)=>b[1]-a[1]).slice(0,4);

  const circumference = 2 * Math.PI * 54;
  const dashOffset = circumference * (1 - score/100);

  document.getElementById('score-section').innerHTML = `
    <div class="score-ring-wrap">
      <svg viewBox="0 0 120 120">
        <circle cx="60" cy="60" r="54" fill="none" stroke="${'#e0dbd2'}" stroke-width="8"/>
        <circle cx="60" cy="60" r="54" fill="none" stroke="${color}" stroke-width="8"
          stroke-dasharray="${circumference}" stroke-dashoffset="${dashOffset}"
          stroke-linecap="round" style="transition:stroke-dashoffset 1s ease"/>
      </svg>
      <div class="score-number">
        <div class="score-num" style="color:${color}">${score}</div>
        <div class="score-label">/ 100</div>
      </div>
    </div>
    <div class="score-text">
      <h2>${label}</h2>
      <p>${verdict}</p>
      <div class="risk-tags">
        ${topExposures.map(([cls, pct])=>{
          const type = pct>40?'red':pct>20?'yellow':'green';
          return `<span class="risk-tag ${type}">${cls}: ${pct.toFixed(0)}%</span>`;
        }).join('')}
      </div>
    </div>
  `;
}

// =============================================
// RENDER HEATMAP
// =============================================
function renderHeatmap(portfolio){
  const n = portfolio.length;
  let html = `<table class="heatmap-table"><thead><tr><th class="row-head"></th>`;
  portfolio.forEach(h=>{
    const short = h.name.length>8 ? h.name.substring(0,7)+'…' : h.name;
    html += `<th title="${h.name}">${short}</th>`;
  });
  html += '</tr></thead><tbody>';

  portfolio.forEach((a,i)=>{
    html += `<tr><td class="row-label">${a.name}</td>`;
    portfolio.forEach((b,j)=>{
      const corr = getCorr(a.assetClass, b.assetClass);
      const bg = corrToColor(corr);
      const textColor = corr > 0.5 ? '#fff' : corr < -0.1 ? '#fff' : '#333';
      const display = i===j ? '—' : corr.toFixed(2);
      html += `<td style="background:${bg};color:${textColor}" title="${a.name} vs ${b.name}: ${corr.toFixed(2)}">${display}</td>`;
    });
    html += '</tr>';
  });

  html += `</tbody></table>
    <div class="heatmap-legend">
      <span>Low corr (good)</span>
      <div class="legend-grad"></div>
      <span>High corr (risky)</span>
    </div>`;

  document.getElementById('heatmap-wrap').innerHTML = html;
}

function corrToColor(c){
  if(c >= 1) return '#e8401c';
  if(c >= 0.8) return '#e86030';
  if(c >= 0.6) return '#f59460';
  if(c >= 0.4) return '#f8c4a0';
  if(c >= 0.2) return '#f5ede4';
  if(c >= 0.0) return '#f5f2ec';
  if(c >= -0.1) return '#daeef0';
  return '#1a9c5b';
}

