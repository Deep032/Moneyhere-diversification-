  document.getElementById('div-bars').innerHTML = html;
}

// =============================================
// BUCKET ANALYSIS
// =============================================
function renderBuckets(portfolio){
  // Group assets by average correlation to rest
  const groups = { high: [], med: [], low: [] };

  portfolio.forEach(a=>{
    const others = portfolio.filter(b=>b!==a);
    const avg = others.length
      ? others.reduce((s,b)=>s+getCorr(a.assetClass,b.assetClass),0)/others.length
      : 0;
    a._avgCorr = avg;
    if(avg>0.6) groups.high.push(a);
    else if(avg>0.3) groups.med.push(a);
    else groups.low.push(a);
  });

  const cards = [
    { key:'high', title:'HIGH CORRELATION', sub:'Move together', cls:'high-corr', icon:'🔴', items: groups.high },
    { key:'med',  title:'MEDIUM CORRELATION', sub:'Some overlap', cls:'med-corr',  icon:'🟡', items: groups.med  },
    { key:'low',  title:'LOW CORRELATION', sub:'True diversifiers', cls:'low-corr', icon:'🟢', items: groups.low  },
  ].filter(g=>g.items.length>0);

  document.getElementById('buckets').innerHTML = cards.map(g=>`
    <div class="bucket-card ${g.cls}">
      <div class="bucket-title">${g.icon} ${g.title}</div>
      <div class="bucket-count">${g.items.length} holding${g.items.length!==1?'s':''} · ${g.sub}</div>
      <div class="bucket-items">
        ${g.items.map(h=>`
          <div class="bucket-item">
            <div class="bucket-dot" style="background:${SECTOR_COLORS[h.assetClass]||'#999'}"></div>
            <span>${h.name} <span style="color:var(--ink3);font-size:11px">(${(h.weight*100).toFixed(0)}%)</span></span>
          </div>`).join('')}
      </div>
    </div>
  `).join('');
}

// =============================================
// INSIGHTS
// =============================================
function renderInsights(score, portfolio, avgCorr){
  const insights = [];

  // Class concentration check
  const classExp = {};
  portfolio.forEach(h=>{ classExp[h.assetClass] = (classExp[h.assetClass]||0) + h.weight*100; });
  const topClass = Object.entries(classExp).sort((a,b)=>b[1]-a[1])[0];

  if(topClass[1]>60){
    insights.push({type:'bad', icon:'⚠️', title:`${topClass[1].toFixed(0)}% in ${topClass[0]} — that's a single-bet risk`, text:`Over half your portfolio is in one asset class. If ${topClass[0]} sells off hard, your entire portfolio takes the hit regardless of how many tickers you hold within it.`});
  }

  // US Equity heavy check
  const usEqPct = classExp['US Equities']||0;
  if(usEqPct>50){
    insights.push({type:'bad', icon:'🇺🇸', title:`Heavy US equity concentration (${usEqPct.toFixed(0)}%)`, text:`Most of your wealth moves with US market sentiment. Consider adding international equities, bonds, or real assets to reduce your exposure to a single geography and risk factor.`});
  }

  // Crypto check
  const cryptoPct = classExp['Crypto']||0;
  if(cryptoPct>25){
    insights.push({type:'warn', icon:'₿', title:`Crypto at ${cryptoPct.toFixed(0)}% — high volatility weight`, text:`Crypto has a relatively low correlation to traditional assets on average, which can help diversification. But its extreme volatility means it can dominate your portfolio's daily moves. Most risk frameworks suggest keeping crypto below 10–15%.`});
  }

  // Gold / bonds check
  const goldPct = classExp['Gold']||0;
  const bondPct = (classExp['US Bonds']||0)+(classExp['Intl Bonds']||0);
  if(goldPct===0 && bondPct===0 && score<60){
    insights.push({type:'warn', icon:'🥇', title:`No defensive assets — nothing to hedge a crash`, text:`You have no Gold or Bonds in your portfolio. These are historically your best protection when equities sell off hard. Even a 10–15% allocation to Treasuries or gold can significantly reduce drawdown risk.`});
  }

  // Good diversification
  const uniqueClasses = Object.keys(classExp).length;
  if(uniqueClasses>=4 && score>=60){
    insights.push({type:'good', icon:'✅', title:`${uniqueClasses} asset classes — genuine spread`, text:`Your portfolio spans multiple asset classes with different return drivers. This means not every holding will fall simultaneously in a market shock. That's real diversification, not just owning more tickers.`});
  }

  // Low corr assets present
  const hasGold = goldPct>0;
  const hasBonds = bondPct>0;
  if(hasGold && hasBonds){
    insights.push({type:'good', icon:'🛡️', title:`Gold + Bonds = built-in shock absorbers`, text:`You hold both gold and bonds, which historically move opposite to equities during crises. During the 2008 crash, Treasuries surged while stocks fell 50%. This combination gives your portfolio real downside protection.`});
  }

  // Many tickers, few classes
  const sameClassPairs = portfolio.filter(h=>classExp[h.assetClass]>30 && h.weight*100<classExp[h.assetClass]-5);
  if(sameClassPairs.length>2){
    insights.push({type:'warn', icon:'🎭', title:`Multiple tickers, same risk factor`, text:`You hold several assets that belong to the same asset class. Owning AAPL, MSFT, and NVDA feels like diversification but they all respond to the same macro forces — US tech sentiment, Fed policy, risk appetite. You need different asset classes, not just different names.`});
  }

  if(insights.length===0){
    insights.push({type:'good', icon:'🎯', title:`Solid portfolio structure`, text:`Your holdings appear to be spread across genuinely uncorrelated asset classes. Keep monitoring this as market correlations can spike during crises — assets that normally move independently can become highly correlated when panic sets in.`});
  }

  document.getElementById('insights').innerHTML = insights.map(ins=>`
    <div class="insight-card ${ins.type}">
      <div class="insight-icon">${ins.icon}</div>
      <div class="insight-text">
        <strong>${ins.title}</strong>
        <p>${ins.text}</p>
      </div>
    </div>`).join('');
}

