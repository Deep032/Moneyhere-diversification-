function parsePaste(){
  const raw = document.getElementById('paste-input').value;
  const lines = raw.trim().split('\n').filter(l=>l.trim());
  pastedHoldings = [];
  let errors = 0;

  lines.forEach(line=>{
    const parts = line.split(',').map(p=>p.trim());
    let name='', assetClass='US Equities', alloc=0;

    if(parts.length>=3){
      name = parts[0];
      assetClass = matchAssetClass(parts[1]) || 'US Equities';
      alloc = parseFloat(parts[2].replace('%',''))||0;
    } else if(parts.length===2){
      name = parts[0];
      alloc = parseFloat(parts[1].replace('%',''))||0;
      assetClass = TICKER_MAP[name.toUpperCase()] || 'US Equities';
    } else {
      const m = line.match(/^([A-Za-z\s]+)\s+([\d.]+)%?$/);
      if(m){
        name = m[1].trim();
        alloc = parseFloat(m[2])||0;
        assetClass = TICKER_MAP[name.toUpperCase()] || 'US Equities';
      } else errors++;
    }

    if(name && alloc>0) pastedHoldings.push({name, assetClass, alloc});
  });

  const total = pastedHoldings.reduce((s,h)=>s+h.alloc,0);
  const status = document.getElementById('paste-status');
  if(pastedHoldings.length>0){
    status.innerHTML = `✓ ${pastedHoldings.length} holdings parsed · Total: <span style="color:${Math.abs(total-100)<0.5?'var(--green)':'var(--red)'}">${total.toFixed(1)}%</span>${errors>0?` · ${errors} lines skipped`:''}`;
  } else {
    status.textContent = 'No valid holdings found yet.';
  }
  checkReady();
}

function matchAssetClass(str){
  const s = str.toLowerCase();
  for(const ac of ASSET_CLASSES){
    if(ac.toLowerCase().includes(s) || s.includes(ac.toLowerCase().split(' ')[0])) return ac;
  }
  return null;
}

// =============================================
