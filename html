function autoClassify(id, val){
  const upper = val.toUpperCase().trim();
  const mapped = TICKER_MAP[upper];
  if(mapped){
    updateHolding(id,'assetClass',mapped);
    const sel = document.getElementById('class-'+id);
    if(sel) sel.value = mapped;
  }
  updateHolding(id,'name',val);
}

function updateHolding(id, field, value){
  const h = holdings.find(h=>h.id===id);
  if(h) h[field] = value;
  updateAllocBar();
  checkReady();
}

function updateAllocBar(){
  const total = holdings.reduce((s,h)=>s+(parseFloat(h.alloc)||0),0);
  const track = document.getElementById('alloc-track');
  const totalEl = document.getElementById('alloc-total');
  const labelsEl = document.getElementById('alloc-labels');

  track.innerHTML = holdings.map(h=>{
    const pct = Math.min(parseFloat(h.alloc)||0, 100);
    const col = SECTOR_COLORS[h.assetClass]||'#999';
    return `<div style="width:${pct}%;background:${col};height:100%;transition:width 0.3s"></div>`;
  }).join('');

  totalEl.textContent = total.toFixed(1)+'%';
  totalEl.className = 'alloc-total '+(Math.abs(total-100)<0.5?'ok':total>100?'over':'under');

  labelsEl.innerHTML = holdings.filter(h=>parseFloat(h.alloc)>0).map(h=>{
    const col = SECTOR_COLORS[h.assetClass]||'#999';
    return `<span style="color:${col};margin-right:8px">${h.name||h.assetClass} ${h.alloc}%</span>`;
